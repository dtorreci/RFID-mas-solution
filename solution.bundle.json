      {
        "reactor_id": "rfid_kinematic_proximity_guard",
        "input_message_type": "RawTagRead",
        "output_message_type": "TagRadialMotion",
        "context_query": "",
        "trigger_condition": "has(payload.epc) \u0026\u0026 size(string(payload.epc)) \u003e 0",
        "transformation_expression": {
          "antenna_id": "int(payload.antenna)",
          "antenna_model": "'Keonn Advan-CP1 EU'",
          "current_rssi_dbm": "double(payload.rssi)",
          "delta_rssi_dbm": "0.0",
          "device_mac": "string(payload.device_mac)",
          "distance_confidence_zone": "double(payload.rssi) \u003e= 55.0 ? 'ON_ANTENNA_SURFACE' : (double(payload.rssi) \u003e= 50.0 ? 'IMMEDIATE_PROXIMITY' : (double(payload.rssi) \u003e= 42.0 ? 'NEAR_FIELD_ZONE' : 'MID_TRANSIT_ZONE'))",
          "distance_correction_margin_m": "double(payload.rssi) \u003e= 55.0 ? 0.01 : (double(payload.rssi) \u003e= 50.0 ? 0.02 : 0.05)",
          "dwell_channel": "1",
          "epc_hex": "string(payload.epc)",
          "estimated_distance_m": "double(payload.rssi) \u003e= 55.0 ? 0.01 : (double(payload.rssi) \u003e= 50.0 ? 0.01 + (55.0 - double(payload.rssi)) * 0.014 : (double(payload.rssi) \u003e= 42.0 ? 0.08 + (50.0 - double(payload.rssi)) * 0.025 : 0.28 + (42.0 - double(payload.rssi)) * 0.045))",
          "gtin14": "'07621806175810'",
          "motion_description": "double(payload.rssi) \u003e= 55.0 ? 'Tag literalmente POSADO sobre la antena Keonn (Contacto Físico)' : (double(payload.rssi) \u003e= 50.0 ? 'Tag en PROXIMIDAD INMEDIATA (2-5 cm)' : 'Tag en CAMPO CERCANO')",
          "motion_direction": "double(payload.rssi) \u003e= 55.0 ? 'ON_SURFACE' : (double(payload.rssi) \u003e= 50.0 ? 'NEAR_PROXIMITY' : 'FAR_FIELD')",
          "previous_rssi_dbm": "double(payload.rssi)",
          "reader_id": "string(payload.reader_id)",
          "serial_number": "'12779363114'",
          "standard": "'SGTIN-96'",
          "timestamp": "has(payload.timestamp) ? string(payload.timestamp) : '2026-11-12T20:30:00Z'"
        },
        "cron": ""
      },
      {
        "reactor_id": "rfid_on_surface_translation_dispatcher",
        "input_message_type": "TagRadialMotion",
        "output_message_type": "RfidAlertTranslationRequest",
        "context_query": "",
        "trigger_condition": "has(payload.motion_direction) \u0026\u0026 payload.motion_direction == 'ON_SURFACE'",
        "transformation_expression": {
          "epc_hex": "string(payload.epc_hex)",
          "gtin14": "string(payload.gtin14)",
          "language": "'VAL'",
          "message": "'🎯 ¡Tag posado en antena Keonn Advan-CP1!\\n• GTIN-14: ' + string(payload.gtin14) + '\\n• Serial: ' + string(payload.serial_number) + '\\n• EPC: ' + string(payload.epc_hex) + '\\n• RSSI: ' + string(payload.current_rssi_dbm) + ' dBm\\n• Distancia: ' + string(payload.estimated_distance_m) + ' m\\n• Lector MAC: ' + string(payload.device_mac)",
          "phone_number": "'all'",
          "reader_mac": "string(payload.device_mac)",
          "rssi": "double(payload.current_rssi_dbm)",
          "serial_number": "string(payload.serial_number)",
          "timestamp": "has(payload.timestamp) ? string(payload.timestamp) : '2026-11-13T12:35:00Z'"
        },
        "cron": ""
      },
      {
        "reactor_id": "idx4000_raw_rfid_normalizer",
        "input_message_type": "RawIngressEvent",
        "output_message_type": "RawTagRead",
        "context_query": "",
        "trigger_condition": "payload.subpath.startsWith('rfid/idx4000') \u0026\u0026 payload.content_type == 'json' \u0026\u0026 has(payload.payload.epc)",
        "transformation_expression": {
          "antenna": "int(payload.payload.antenna)",
          "device_mac": "has(payload.payload.mac) ? string(payload.payload.mac) : '00:50:f9:d1:0a:2b'",
          "dock_portal": "string(payload.subpath)",
          "epc": "string(payload.payload.epc)",
          "read_count": "has(payload.payload.read_count) ? int(payload.payload.read_count) : 1",
          "reader_id": "has(payload.payload.reader_id) ? string(payload.payload.reader_id) : 'idx4000-d10a2b'",
          "reader_vendor": "'Sensormatic'",
          "rssi": "double(payload.payload.rssi)",
          "timestamp": "has(payload.payload.timestamp) ? string(payload.payload.timestamp) : '2026-11-12T20:30:00Z'"
        },
        "cron": ""
